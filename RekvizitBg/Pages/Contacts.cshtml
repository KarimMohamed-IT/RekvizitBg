@page
@model ContactsModel
@{
    ViewData["Title"] = "Контакти";
}

<!-- ===== CONTACT HERO ===== -->
<section class="contact-hero">
    <div class="contact-hero-bg" style="background-image: url('/images/contactus.webp');"></div>
    <div class="container text-center py-5">
        <span class="hero-badge"><i class="fa-solid fa-address-book"></i> Свържете се с нас</span>
        <h1 class="hero-title">Как можем да <span class="highlight">помогнем?</span></h1>
        <p class="hero-subtitle">Ние сме на разположение да отговорим на всички ваши въпроси за наем на реквизити.</p>
    </div>
</section>

<!-- ===== CONTACT SECTION ===== -->
<section class="contact-section">
    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success mb-5 text-center reveal">
                <i class="fa-solid fa-circle-check" style="font-size: 1.2rem;"></i> @TempData["SuccessMessage"]
            </div>
        }

        <div class="row g-5">
            <!-- Contact Info -->
            <div class="col-lg-5 reveal">
                <div class="contact-info-card">
                    <h3 class="mb-4" style="font-size: 1.3rem;"><i class="fa-solid fa-circle-info text-gold"></i> Контактна информация</h3>
                    
                    <div class="contact-info-item">
                        <div class="contact-info-icon"><i class="fa-solid fa-phone"></i></div>
                        <div class="contact-info-text">
                            <h5>Телефон</h5>
                            <a href="tel:+359897088791">+359 897 088 791</a>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-info-icon"><i class="fa-solid fa-envelope"></i></div>
                        <div class="contact-info-text">
                            <h5>Имейл</h5>
                            <a href="mailto:rekvizit.bg@gmail.com">rekvizit.bg@gmail.com</a>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-info-icon"><i class="fa-brands fa-viber"></i></div>
                        <div class="contact-info-text">
                            <h5>Viber</h5>
                            <p>+359 897 088 791</p>
                        </div>
                    </div>

                    <div class="contact-info-item">
                        <div class="contact-info-icon"><i class="fa-brands fa-whatsapp"></i></div>
                        <div class="contact-info-text">
                            <h5>WhatsApp</h5>
                            <a href="https://wa.me/359897088791">Изпратете съобщение</a>
                        </div>
                    </div>

                    <hr style="border-color: var(--border-subtle); margin: 24px 0;">

                    <p style="font-size: 0.9rem; color: var(--text-muted);">
                        <i class="fa-solid fa-clock text-gold"></i> <strong>Работно време:</strong><br>
                        Понеделник - Петък: 09:00 - 18:00<br>
                        Събота: 10:00 - 15:00
                    </p>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-lg-7 reveal reveal-delay-2">
                <div class="contact-form-card">
                    <h3 class="mb-4" style="font-size: 1.3rem;"><i class="fa-solid fa-pen-to-square text-gold"></i> Изпратете запитване</h3>
                    <form method="post" asp-page-handler="SendMessage" id="contactForm">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="form-floating-label">
                                    <label for="name"><i class="fa-solid fa-user"></i> Име</label>
                                    <input type="text" id="name" name="name" placeholder="Вашето име" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating-label">
                                    <label for="email"><i class="fa-solid fa-envelope"></i> Имейл</label>
                                    <input type="email" id="email" name="email" placeholder="email@example.com" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating-label">
                                    <label for="phone"><i class="fa-solid fa-phone"></i> Телефон</label>
                                    <input type="tel" id="phone" name="phone" placeholder="+359 ..." required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating-label">
                                    <label for="subject"><i class="fa-solid fa-tag"></i> Относно</label>
                                    <input type="text" id="subject" name="subject" placeholder="Тема на запитването" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating-label">
                                    <label for="message"><i class="fa-solid fa-comment-dots"></i> Съобщение</label>
                                    <textarea id="message" name="message" placeholder="Опишете вашите нужди — какви реквизити търсите, за какъв тип продукция, период на наемане и т.н." required></textarea>
                                </div>
                            </div>
                            <div class="col-12 text-center">
                                <button type="submit" class="btn-gold" id="submitBtn">
                                    <i class="fa-solid fa-paper-plane"></i> Изпратете запитване
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
